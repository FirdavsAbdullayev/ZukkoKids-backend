# ===== ZukkoKids Backend Environment =====

# Server
PORT=5000
NODE_ENV=development

# Frontend manzili(lar)i (CORS). Bir nechta bo'lsa vergul bilan ajrating.
# Vercel'dagi domeningizni qo'shing, masalan:
# CLIENT_URL=https://zukkokids.vercel.app,http://localhost:5173
CLIENT_URL=http://localhost:5173

# ---- Baza: 1-usul — to'liq URL (bulutda tavsiya etiladi) ----
# Render PostgreSQL "Internal/External Database URL" shu yerga qo'yiladi.
# Ushbu o'zgaruvchi mavjud bo'lsa, quyidagi DB_* sozlamalari e'tiborga olinmaydi.
# DATABASE_URL=postgresql://user:password@host:5432/zukkokids

# SSL'ni majburan boshqarish (true/false). Bo'sh qoldirilsa avtomatik aniqlanadi.
# Render ichki ulanishida SSL kerak emas: DB_SSL=false
# DB_SSL=

# ---- Baza: 2-usul — alohida maydonlar (lokal uchun) ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zukkokids
DB_USER=postgres
DB_PASSWORD=postgres
DB_LOGGING=false
